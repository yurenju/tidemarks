{
  "name": "tidemarks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build:frond": "npm run build -w @yurenju/frond",
    "dev": "npm run build:frond && npm run dev -w app",
    "build": "npm run build:frond && npm run build -w app",
    "lint": "oxlint",
    "i18n:check": "node scripts/check-i18n.ts",
    "i18n:extract": "npm run i18n:extract -w app",
    "typecheck": "npm run typecheck -w @yurenju/frond && npm run typecheck -w app && tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:frond && npm run i18n:compile -w app && vitest run",
    "test:container": "./scripts/test-in-container.sh",
    "shots": "./scripts/capture-shots.sh",
    "preview": "npm run preview -w app",
    "worker:dev": "npm run worker:dev -w app",
    "setup:cloudflare": "./scripts/setup-cloudflare.sh",
    "deploy": "node scripts/deploy.ts production",
    "versions:upload": "node scripts/deploy.ts preview",
    "db:migrate:local": "npm run db:migrate:local -w app"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "prettier": "3.9.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true,
    "workerd@1.20260820.1": true
  }
}
