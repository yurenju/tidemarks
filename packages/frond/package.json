{
  "name": "@yurenju/frond",
  "private": true,
  "version": "0.4.15",
  "description": "A TypeScript EPUB rendering library — vertical and horizontal writing, verified across Chromium, Firefox and WebKit",
  "license": "MIT",
  "author": "Yuren Ju <yurenju@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./epub": {
      "types": "./dist/epub/index.d.ts",
      "default": "./dist/epub/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/finish-build.ts",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.ts",
    "trim:books": "node scripts/trim-public-books.ts",
    "test:browser": "playwright test",
    "scan:books": "./scripts/scan-books.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.2.0",
    "@types/pngjs": "6.0.5",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
