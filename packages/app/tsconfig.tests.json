{
  // The browser tests: Playwright driving a real engine, so both halves of the environment are
  // in reach — Node's API in the spec file, the DOM inside every `evaluate()` callback.
  //
  // **Deliberately not a reference of `tsconfig.json`.** `npm run build` is `tsc -b && vite
  // build`, and what ships has no business depending on whether the tests compile. `npm run
  // typecheck` runs this one alongside the build's projects instead, so the check exists
  // without the coupling.
  //
  // Nothing checked these files before this config: the three projects cover `src`, the build's
  // own configuration, and the worker, and `tests/` fell between them. What that cost was
  // invisible rather than loud — a spec with a type error still runs, because Playwright takes
  // its TypeScript through esbuild, which strips types without reading them.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["tests"]
}
