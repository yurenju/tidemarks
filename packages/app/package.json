{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run i18n:compile && vite",
    "build": "npm run i18n:compile -- --strict && tsc -b && vite build",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "typecheck": "npm run i18n:compile && tsc -b --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:browser": "playwright test",
    "sweep": "playwright test --config=playwright.sweep.config.ts",
    "preview": "vite preview",
    "worker:dev": "npm run i18n:compile && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "@cloudflare/workers-oauth-provider": "^0.10.1",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@yurenju/frond": "*",
    "dexie": "^4.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260715.1",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@simplewebauthn/server": "^13.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "~4.125.0"
  }
}
