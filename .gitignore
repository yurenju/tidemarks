# git worktrees opened by Claude Code: per-machine working dirs, never committed
.claude/worktrees/

# wrangler
.wrangler
.dev.vars

# The official deployment's configuration, written by scripts/deploy.ts from Workers Builds'
# build variables on every build. Build output, and it holds the official account's ids.
packages/app/wrangler.generated.json

# Compiled message catalogs, built from the .po files beside them by `lingui compile`. Build
# output: the .po files are the source, and a committed copy of them is a second answer to
# "what does this say in Japanese" that nothing keeps honest.
#
# Both extensions on purpose. The compiler writes `.mjs` under `compileNamespace: "es"` and
# `.js` without it, and a pattern covering only one of them quietly starts committing build
# output the day that setting changes — which is exactly what happened here.
packages/app/src/locales/*.js
packages/app/src/locales/*.mjs

# Playwright output
playwright-report/
test-results/

# Wayfinding: one exploration's working notes, whose life is that exploration and no longer.
# What survives becomes a GitHub issue or a file under docs/specs/ (docs/agents/issue-tracker.md).
.scratch/

# playwright-cli's scratch output: snapshots and console logs it writes beside the repo root
# while capturing evidence on the host (docs/agents/pull-requests.md)
.playwright-cli/

# Commercially published books: kept here for verification, never committed
# (this repository is public, so committing one would be publishing it)
tests/books/commercial/
